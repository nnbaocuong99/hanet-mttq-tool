{
  "manifest_version": 3,
  "name": "hanet-mttq-tool",
  "version": "0.1.3",
  "description": "Tool hỗ trợ",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connect.hanet.ai/*"
      ],
      "js": [
        "core.js",
        "dom.js",
        "content.js",
        "video-core.js",
        "video-dom.js",
        "video-job.js",
        "video-source.js",
        "video-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://*.hanet.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
